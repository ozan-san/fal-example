    {
      "id": 10,
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "Successful requests from this client's view. If local wait tracks the total, the app's own concurrency limit is the bottleneck, not fal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fal_client_request_duration_seconds_bucket{fal_mode=\"$mode\",outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "exemplar": true,
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fal_client_request_duration_seconds_bucket{fal_mode=\"$mode\",outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "exemplar": true,
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fal_client_local_wait_duration_seconds_bucket{fal_mode=\"$mode\"}[$__rate_interval])))",
          "legendFormat": "p95 local wait",
          "refId": "C",
          "exemplar": false,
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
