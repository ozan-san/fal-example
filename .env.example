# mock = simulated fal backend, free. live = real fal API calls, spends credit.
FAL_MODE=mock

# Required only when FAL_MODE=live. Get one at https://fal.ai/dashboard/keys
FAL_KEY=

# Hard lifetime cap on live submissions, persisted across restarts.
# Worst case spend = FAL_MAX_REQUESTS * FAL_COST_PER_MEGAPIXEL_USD (at 1 billed MP per image).
FAL_MAX_REQUESTS=100

GRAFANA_ADMIN_PASSWORD=admin
